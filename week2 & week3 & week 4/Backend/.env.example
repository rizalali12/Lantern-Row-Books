# PostgreSQL connection (used by the app)
PGHOST=localhost
PGPORT=5432
PGDATABASE=lanternbooks
PGUSER=your_db_user
PGPASSWORD=your_db_password

# Server
PORT=3000
FRONTEND_URL=http://localhost:5173

# Auth
# Generate a random value with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret

# Stripe (test mode keys)
# Secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key
# Signing secret printed by: stripe listen --forward-to localhost:3000/api/v1/payments/webhook
STRIPE_WEBHOOK=whsec_your_webhook_secret
